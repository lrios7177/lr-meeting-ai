<Window x:Class="LRMeeting.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LR Meeting AI" Width="1320" Height="900" MinWidth="1060" MinHeight="760" Background="#0B1120" Foreground="#ECF2FC" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
<Window.Resources>
 <SolidColorBrush x:Key="Muted" Color="#95A6C1"/>
 <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
 <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
 <Style TargetType="Button"><Setter Property="Background" Value="#25324C"/><Setter Property="Foreground" Value="#F1F5FD"/><Setter Property="Padding" Value="17,11"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="TextBox"><Setter Property="Background" Value="#0C1527"/><Setter Property="Foreground" Value="#EAF0FC"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#30415E"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="FontSize" Value="14"/></Style>
 <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#15223A"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,0,14"/><Setter Property="FontSize" Value="14"/></Style>
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D5E0F2"/><Setter Property="Margin" Value="0,10,0,18"/></Style>
 <Style TargetType="ProgressBar"><Setter Property="Background" Value="#263550"/><Setter Property="Foreground" Value="#43D9BA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="8"/><Setter Property="Maximum" Value="1"/></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#141E32"/><Setter Property="BorderBrush" Value="#23314B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
 <Style x:Key="Nav" TargetType="RadioButton"><Setter Property="Foreground" Value="#9BAEC9"/><Setter Property="Padding" Value="17,13"/><Setter Property="Margin" Value="12,3"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="NavBorder" CornerRadius="9" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#223954"/><Setter Property="Foreground" Value="#6AE5CD"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="DataGrid"><Setter Property="Background" Value="#111C30"/><Setter Property="Foreground" Value="#E1EAF8"/><Setter Property="RowBackground" Value="#141F33"/><Setter Property="AlternatingRowBackground" Value="#19263C"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#293850"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="FontSize" Value="13"/><Setter Property="MinRowHeight" Value="46"/></Style>
 <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#263550"/><Setter Property="Foreground" Value="#BCD0ED"/><Setter Property="Padding" Value="12"/><Setter Property="BorderThickness" Value="0"/></Style>
 <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10"/><Setter Property="BorderThickness" Value="0"/></Style>
</Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="#10192B" BorderBrush="#22314B" BorderThickness="0,0,1,0"><DockPanel>
  <StackPanel DockPanel.Dock="Top" Margin="28,30,24,30"><Border Background="#35CDB1" Width="46" Height="46" CornerRadius="13" HorizontalAlignment="Left"><TextBlock Text="LR" FontSize="20" FontWeight="Bold" Foreground="#092A29" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Meeting AI" FontSize="23" FontWeight="SemiBold" Margin="0,16,0,5"/><TextBlock Text="CONVERSACIONES CON CLARIDAD" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="24,20,20,28"><Border Background="#182A38" CornerRadius="8" Padding="12"><TextBlock Text="●  Procesamiento local" Foreground="#70DBC6" FontSize="12"/></Border><TextBlock Text="Ing. Luis Ríos, MBA" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,18,0,6"/><TextBlock Text="Windows · Versión 0.3.0" FontSize="11" Foreground="#6D829F"/></StackPanel>
  <StackPanel><RadioButton Style="{StaticResource Nav}" GroupName="Nav" Content="◉    Reunión" x:Name="Nav0" Tag="0" Click="NavigateClick" IsChecked="True"/><RadioButton Style="{StaticResource Nav}" GroupName="Nav" Content="≡    Transcripción" x:Name="Nav1" Tag="1" Click="NavigateClick"/><RadioButton Style="{StaticResource Nav}" GroupName="Nav" Content="▤    Informe ejecutivo" x:Name="Nav2" Tag="2" Click="NavigateClick"/><RadioButton Style="{StaticResource Nav}" GroupName="Nav" Content="◷    Historial" x:Name="Nav3" Tag="3" Click="NavigateClick"/><RadioButton Style="{StaticResource Nav}" GroupName="Nav" Content="⚙    Ajustes" x:Name="Nav4" Tag="4" Click="NavigateClick"/></StackPanel>
 </DockPanel></Border>
 <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
  <Border BorderBrush="#23314B" BorderThickness="0,0,0,1" Padding="30,18"><Grid><StackPanel><TextBlock x:Name="PageTitle" Text="Tu próxima reunión, más clara." FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Graba, revisa y transforma la conversación en decisiones." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1B2842" CornerRadius="18" Padding="14,8"><TextBlock x:Name="EngineBadge" Text="IA local · configura los motores" FontSize="11" Foreground="#BFCFE9"/></Border></Grid></Border>
  <TabControl x:Name="Pages" Grid.Row="1" Background="Transparent" BorderThickness="0"><TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
   <TabItem Header="Reunión"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,26,30,12">
    <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ESPACIO DE REUNIÓN" Style="{StaticResource Caption}"/><TextBox x:Name="MeetingTitle" Text="Nueva reunión" FontSize="23" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" Padding="0,4"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="Clock" Text="00:00:00" FontSize="32" FontWeight="Light"/><TextBlock x:Name="RecordingState" Text="Lista para comenzar" Foreground="#89A2C6" FontSize="12" HorizontalAlignment="Right"/></StackPanel></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="A  /  PARTICIPANTES" Style="{StaticResource Caption}"/><TextBlock Text="Audio de la reunión" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock Text="Salida de Windows · WASAPI Loopback" Style="{StaticResource Caption}"/><ComboBox x:Name="Outputs"/><ProgressBar x:Name="LevelA"/><TextBlock Text="Teams, Meet, Webex y otras aplicaciones" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="B  /  TU VOZ" Style="{StaticResource Caption}"/><TextBlock Text="Micrófono" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock Text="Selecciona el dispositivo de entrada" Style="{StaticResource Caption}"/><ComboBox x:Name="Inputs"/><ProgressBar x:Name="LevelB" Foreground="#AD9BFF"/><TextBlock Text="Integrado, USB o micrófono externo" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
    </Grid>
    <Border Style="{StaticResource Card}"><StackPanel><WrapPanel><Button x:Name="Record" Content="●  Iniciar reunión" Click="RecordClick" Background="#35CDB1" Foreground="#072A27" FontWeight="SemiBold"/><Button x:Name="Pause" Content="Pausar" Click="PauseClick" IsEnabled="False"/><Button x:Name="Stop" Content="■  Terminar reunión" Click="StopClick" IsEnabled="False"/><Button x:Name="Test" Content="Prueba de audio · 30 s" Click="TestClick"/><Button x:Name="Refresh" Content="↻ Dispositivos" Click="RefreshClick"/></WrapPanel><CheckBox x:Name="AutoProcess" Content="Transcribir progresivamente y generar el informe al terminar" IsChecked="True"/><TextBlock Text="Usa audífonos para reducir eco. Prueba y escucha ambos canales antes de tu primera reunión." FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Status" Text="Selecciona los dispositivos y configura los motores locales en Ajustes." FontSize="14" Margin="0,15,0,0" Foreground="#92E2D3"/></StackPanel></Border>
    <WrapPanel><Button x:Name="PlayA" Content="▷ Escuchar participantes" Click="PlayAClick" IsEnabled="False"/><Button x:Name="PlayB" Content="▷ Escuchar micrófono" Click="PlayBClick" IsEnabled="False"/><Button Content="Detener reproducción" Click="StopPlaybackClick"/><Button x:Name="Archive" Content="Guardar paquete de reunión" Click="ArchiveClick" IsEnabled="False"/><Button Content="Abrir carpeta" Click="OpenFolderClick"/></WrapPanel>
    <Expander Header="Actividad y diagnóstico" Foreground="{StaticResource Muted}" Margin="0,10"><TextBox x:Name="Messages" IsReadOnly="True" TextWrapping="Wrap" Height="150" VerticalScrollBarVisibility="Auto" FontSize="11" Margin="0,12,0,0"/></Expander>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Transcripción"><Grid Margin="30,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,18"><TextBlock Text="Cada idea, con su contexto." Style="{StaticResource Heading}"/><TextBlock Text="El texto aparece por bloques. Puedes corregirlo al detener la reunión; se conserva el original." Foreground="{StaticResource Muted}"/><TextBlock x:Name="TranscriptState" Text="Aún no hay segmentos." Foreground="#69D7C2" Margin="0,12,0,0"/></StackPanel><DataGrid x:Name="TranscriptGrid" Grid.Row="1" SelectionMode="Single" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Tiempo" Binding="{Binding Time}" Width="100" IsReadOnly="True"/><DataGridTextColumn Header="Fuente" Binding="{Binding Channel}" Width="90" IsReadOnly="True"/><DataGridTextColumn Header="Texto · doble clic para corregir" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="2" Margin="0,20,0,0"><Button x:Name="SaveText" Content="Guardar correcciones" Click="SaveTextClick"/><Button x:Name="Process" Content="Transcribir y generar informe" Click="ProcessClick" Background="#4865C3"/><Button x:Name="CancelAI" Content="Cancelar procesamiento IA" Click="CancelAIClick" IsEnabled="False"/><Button x:Name="Import" Content="Importar audio" Click="ImportClick"/></WrapPanel></Grid></TabItem>
   <TabItem Header="Informe"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,26"><TextBlock Text="De la conversación a la acción." Style="{StaticResource Heading}"/><TextBlock Text="Resumen objetivo, acuerdos y próximos pasos. Un borrador para revisar y compartir." Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="TopicCount" Text="—" FontSize="32" Foreground="#64DFC6"/><TextBlock Text="Temas tratados" Foreground="{StaticResource Muted}"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="DecisionCount" Text="—" FontSize="32" Foreground="#ADA2F5"/><TextBlock Text="Acuerdos identificados" Foreground="{StaticResource Muted}"/></StackPanel></Border><Border Grid.Column="4" Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="ActionCount" Text="—" FontSize="32" Foreground="#F0CB83"/><TextBlock Text="Tareas pendientes" Foreground="{StaticResource Muted}"/></StackPanel></Border></Grid>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="RESUMEN EJECUTIVO" Style="{StaticResource Caption}"/><TextBlock x:Name="ReportSummary" Text="El informe aparecerá aquí cuando finalice el análisis local. Configura Whisper.cpp y Ollama en Ajustes para comenzar." FontSize="17" LineHeight="29"/><TextBlock x:Name="ReportStatus" Text="Sin informe generado" Foreground="#E8C982" FontSize="12" Margin="0,20,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ACUERDOS Y PLAN DE ACCIÓN" Style="{StaticResource Caption}"/><TextBlock x:Name="ReportDetails" Text="Cada conclusión incluirá referencias a la transcripción. Los responsables y fechas no confirmados se indicarán como pendientes." LineHeight="25" Foreground="#BDCDE4"/></StackPanel></Border>
    <WrapPanel><Button x:Name="OpenReport" Content="Abrir informe / Guardar PDF" Click="OpenReportClick" Background="#35CDB1" Foreground="#072A27" IsEnabled="False"/><Button x:Name="Regenerate" Content="Regenerar desde texto revisado" Click="ProcessClick"/></WrapPanel><TextBlock Text="El informe HTML se abre en tu navegador. Usa Imprimir → Guardar como PDF. Verifica nombres, cifras y decisiones antes de compartir." Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Historial"><Grid Margin="30,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,20"><TextBlock Text="Tus conversaciones, en un solo lugar." Style="{StaticResource Heading}"/><TextBlock Text="Selecciona una reunión para revisar el audio, corregir el texto o reanudar su procesamiento." Foreground="{StaticResource Muted}"/></StackPanel><DataGrid x:Name="HistoryGrid" Grid.Row="1" IsReadOnly="True" SelectionMode="Single" SelectionChanged="HistorySelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Reunión" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Fecha" Binding="{Binding CreatedUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="230"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="Ajustes"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,26"><TextBlock Text="Tu IA. En tu equipo." Style="{StaticResource Heading}"/><TextBlock Text="Instala los motores una vez. El procesamiento utiliza los archivos locales y Ollama en este equipo." Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="01  /  TRANSCRIPCIÓN · WHISPER.CPP" Style="{StaticResource Caption}"/><TextBlock Text="Ejecutable whisper-cli.exe" Style="{StaticResource Caption}"/><DockPanel><Button DockPanel.Dock="Right" Content="Buscar…" Click="BrowseWhisperClick"/><TextBox x:Name="WhisperPath"/></DockPanel><TextBlock Text="Modelo multilingüe de Whisper · archivo .bin" Style="{StaticResource Caption}"/><DockPanel><Button DockPanel.Dock="Right" Content="Buscar…" Click="BrowseModelClick"/><TextBox x:Name="ModelPath"/></DockPanel><TextBlock Text="Idioma de transcripción" Style="{StaticResource Caption}"/><ComboBox x:Name="LanguageChoice" SelectedIndex="0" Width="220" HorizontalAlignment="Left"><ComboBoxItem Content="Español" Tag="es"/><ComboBoxItem Content="English" Tag="en"/></ComboBox><Button Content="Abrir descargas de Whisper.cpp" Click="WhisperDownloadsClick" HorizontalAlignment="Left"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="02  /  INFORMES · OLLAMA LOCAL" Style="{StaticResource Caption}"/><TextBlock Text="Dirección local" Style="{StaticResource Caption}"/><TextBox x:Name="OllamaUrl" Text="http://127.0.0.1:11434"/><TextBlock Text="Nombre del modelo instalado" Style="{StaticResource Caption}"/><TextBox x:Name="OllamaModel" Text="qwen3:4b"/><TextBlock Text="Ejemplo de instalación del modelo: ollama pull qwen3:4b. Requiere Ollama y espacio suficiente; no se descarga automáticamente." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,18"/><WrapPanel><Button Content="Guardar ajustes" Click="SaveSettingsClick" Background="#4865C3"/><Button x:Name="CheckEngines" Content="Comprobar configuración y Ollama" Click="CheckEnginesClick"/><Button Content="Abrir Ollama" Click="OllamaDownloadsClick"/></WrapPanel><TextBlock x:Name="EngineStatus" Text="Pendiente de configuración" Foreground="#8EDCCA"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="#10192B" Padding="30,12"><Grid><TextBlock x:Name="GlobalStatus" Text="Audio local · sin servicios de transcripción externos" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock Text="Revisa el borrador antes de compartirlo" HorizontalAlignment="Right" FontSize="11" Foreground="#6E83A4"/></Grid></Border>
 </Grid>
</Grid></Window>
