 <TabItem Header="Estudio"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,24,30,16">
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Dale espacio a la conversación." FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Dos fuentes sincronizadas. Un espacio para tus ideas." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel><Border Grid.Column="1" Background="#E6EBE0" CornerRadius="12" Padding="13,10" VerticalAlignment="Center" Margin="16,0,0,0"><TextBlock Text="AUDIO Y ANÁLISIS EN TU EQUIPO" Foreground="#4E6356" FontSize="10" HorizontalAlignment="Center"/></Border></Grid>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
   <StackPanel>
    <Border Background="#152A26" CornerRadius="22" Padding="23" Margin="0,0,0,14"><StackPanel><Grid><TextBlock Text="01   PARTICIPANTES" Foreground="#BCE7BB" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="AUDIO DE WINDOWS" HorizontalAlignment="Right" FontSize="9" Foreground="#97B0A6"/></Grid><TextBlock Text="La conversación" Foreground="#F1F6EE" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,12"/><ComboBox x:Name="Outputs" AutomationProperties.Name="Salida de audio de los participantes"/><local:VoiceMeter x:Name="VoiceA" Height="88" Accent="#BCE7BB"/><ProgressBar x:Name="LevelA" Margin="0,12,0,0" AutomationProperties.Name="Nivel de participantes"/><Grid Margin="0,12,0,0"><TextBlock Text="Nivel de participantes" Foreground="#A8BDB1" FontSize="10"/><Button x:Name="PlayA" Content="▷  Escuchar canal" Click="PlayAClick" IsEnabled="False" Background="#2D463D" Foreground="#D7EBD8" BorderThickness="0" Margin="0" Padding="10,5" HorizontalAlignment="Right" FontSize="10"/></Grid></StackPanel></Border>
    <Border Background="#242B35" CornerRadius="22" Padding="23"><StackPanel><Grid><TextBlock Text="02   MICRÓFONO" Foreground="#AFC8F0" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="TU APORTE" HorizontalAlignment="Right" FontSize="9" Foreground="#9CAABF"/></Grid><TextBlock Text="Tu voz también cuenta" Foreground="#F1F4FB" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,12"/><ComboBox x:Name="Inputs" AutomationProperties.Name="Micrófono del usuario"/><local:VoiceMeter x:Name="VoiceB" Height="88" Accent="#AFC8F0"/><ProgressBar x:Name="LevelB" Foreground="#AFC8F0" Background="#3B4553" Margin="0,12,0,0" AutomationProperties.Name="Nivel del micrófono"/><Grid Margin="0,12,0,0"><TextBlock Text="Nivel de tu micrófono" Foreground="#ACB6C7" FontSize="10"/><Button x:Name="PlayB" Content="▷  Escuchar canal" Click="PlayBClick" IsEnabled="False" Background="#394353" Foreground="#DAE6FA" BorderThickness="0" Margin="0" Padding="10,5" HorizontalAlignment="Right" FontSize="10"/></Grid></StackPanel></Border>
   </StackPanel>
   <Border Grid.Column="2" Background="#FCFCF8" BorderBrush="#D9DED3" BorderThickness="1" CornerRadius="22" Padding="24"><StackPanel>
    <TextBlock Text="CONTROL DE SESIÓN" Style="{StaticResource Caption}"/><TextBox x:Name="MeetingTitle" Text="Nueva reunión" FontSize="21" FontWeight="SemiBold" Background="Transparent" BorderThickness="0,0,0,1" Padding="0,9,0,13" Margin="0,0,0,20"/>
    <TextBlock x:Name="Clock" Text="00:00:00" FontFamily="Consolas" FontSize="42" Foreground="#263C35" HorizontalAlignment="Center"/>
    <TextBlock x:Name="RecordingState" Text="Lista para comenzar" Foreground="#6B7473" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,22"/>
    <Button x:Name="Record" Click="RecordClick" Background="#D95531" Foreground="White" BorderThickness="0" Margin="0,0,0,12" Padding="16,19" FontSize="16"><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="White" Margin="0,0,10,0"/><TextBlock Text="Iniciar reunión"/></StackPanel></Button>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="Pause" Content="Ⅱ  Pausar" Click="PauseClick" IsEnabled="False" Margin="0,0,6,12" Padding="8,11"/><Button x:Name="Stop" Grid.Column="1" Content="■  Terminar" Click="StopClick" IsEnabled="False" Margin="6,0,0,12" Padding="8,11"/></Grid>
    <CheckBox x:Name="AutoProcess" IsChecked="True"><TextBlock Text="Transcribir y crear el informe al terminar" FontSize="12" Width="240"/></CheckBox>
    <Border Background="#F0F2E9" CornerRadius="12" Padding="14" Margin="0,0,0,16"><StackPanel><TextBlock Text="ANTES DE EMPEZAR" FontSize="9" FontWeight="SemiBold" Foreground="#61745E"/><TextBlock Text="Usa audífonos y comprueba que ambos canales reciben sonido." Foreground="#5C6A58" FontSize="12" Margin="0,7,0,10"/><Button x:Name="Test" Content="Probar audio · 30 segundos" Click="TestClick" Margin="0" Background="White" Padding="10,10" FontSize="11"/></StackPanel></Border>
    <Button x:Name="Refresh" Content="↻  Actualizar dispositivos" Click="RefreshClick" Margin="0" Background="Transparent" Padding="8,9" FontSize="11"/>
   </StackPanel></Border>
  </Grid>
  <Border Background="#E6EBE0" CornerRadius="12" Padding="16,12" Margin="0,16,0,16"><TextBlock x:Name="Status" Text="Selecciona tus dispositivos. Tu próximo informe comienza aquí." FontSize="13" Foreground="#3E5D48"/></Border>
  <WrapPanel><Button x:Name="Archive" Content="Guardar paquete de reunión" Click="ArchiveClick" IsEnabled="False"/><Button Content="Abrir grabaciones" Click="OpenFolderClick"/><Button Content="Detener reproducción" Click="StopPlaybackClick"/></WrapPanel>
  <Expander Header="Actividad de la sesión y diagnóstico" Foreground="{StaticResource Muted}" Margin="0,8"><TextBox x:Name="Messages" IsReadOnly="True" TextWrapping="Wrap" Height="150" VerticalScrollBarVisibility="Auto" FontSize="11" Margin="0,12,0,0"/></Expander>
 </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Transcripción"><Grid Margin="30,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,18"><TextBlock Text="Cada idea, con su contexto." Style="{StaticResource Heading}"/><TextBlock Text="El texto aparece por bloques. Puedes corregirlo al detener la reunión; se conserva el original." Foreground="{StaticResource Muted}"/><TextBlock x:Name="TranscriptState" Text="Aún no hay segmentos." Foreground="#32615B" Margin="0,12,0,0"/></StackPanel><DataGrid x:Name="TranscriptGrid" Grid.Row="1" SelectionMode="Single" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Tiempo" Binding="{Binding Time}" Width="100" IsReadOnly="True"/><DataGridTextColumn Header="Fuente" Binding="{Binding Channel}" Width="90" IsReadOnly="True"/><DataGridTextColumn Header="Texto · doble clic para corregir" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="2" Margin="0,20,0,0"><Button x:Name="SaveText" Content="Guardar correcciones" Click="SaveTextClick"/><Button x:Name="Process" Content="Transcribir y generar informe" Click="ProcessClick" Background="#D95531"/><Button x:Name="CancelAI" Content="Cancelar procesamiento IA" Click="CancelAIClick" IsEnabled="False"/><Button x:Name="Import" Content="Importar audio" Click="ImportClick"/></WrapPanel></Grid></TabItem>
   <TabItem Header="Informe"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,26"><TextBlock Text="De la conversación a la acción." Style="{StaticResource Heading}"/><TextBlock Text="Resumen objetivo, acuerdos y próximos pasos. Un borrador para revisar y compartir." Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="TopicCount" Text="—" FontSize="32" Foreground="#32615B"/><TextBlock Text="Temas tratados" Foreground="{StaticResource Muted}"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="DecisionCount" Text="—" FontSize="32" Foreground="#7656B9"/><TextBlock Text="Acuerdos identificados" Foreground="{StaticResource Muted}"/></StackPanel></Border><Border Grid.Column="4" Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="ActionCount" Text="—" FontSize="32" Foreground="#AA5826"/><TextBlock Text="Tareas pendientes" Foreground="{StaticResource Muted}"/></StackPanel></Border></Grid>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="RESUMEN EJECUTIVO" Style="{StaticResource Caption}"/><TextBlock x:Name="ReportSummary" Text="El informe aparecerá aquí cuando finalice el análisis local. Configura Whisper.cpp y Ollama en Ajustes para comenzar." FontSize="17" LineHeight="29"/><TextBlock x:Name="ReportStatus" Text="Sin informe generado" Foreground="#99502B" FontSize="12" Margin="0,20,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ACUERDOS Y PLAN DE ACCIÓN" Style="{StaticResource Caption}"/><TextBlock x:Name="ReportDetails" Text="Cada conclusión incluirá referencias a la transcripción. Los responsables y fechas no confirmados se indicarán como pendientes." LineHeight="25" Foreground="#4F565C"/></StackPanel></Border>
    <WrapPanel><Button x:Name="OpenReport" Content="Abrir informe / Guardar PDF" Click="OpenReportClick" Background="#D95531" Foreground="#FFFFFF" IsEnabled="False"/><Button x:Name="Regenerate" Content="Regenerar desde texto revisado" Click="ProcessClick"/></WrapPanel><TextBlock Text="El informe HTML se abre en tu navegador. Usa Imprimir → Guardar como PDF. Verifica nombres, cifras y decisiones antes de compartir." Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Historial"><Grid Margin="30,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,20"><TextBlock Text="Tus conversaciones, en un solo lugar." Style="{StaticResource Heading}"/><TextBlock Text="Selecciona una reunión para revisar el audio, corregir el texto o reanudar su procesamiento." Foreground="{StaticResource Muted}"/></StackPanel><DataGrid x:Name="HistoryGrid" Grid.Row="1" IsReadOnly="True" SelectionMode="Single" SelectionChanged="HistorySelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Reunión" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Fecha" Binding="{Binding CreatedUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="230"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="Ajustes"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,26"><TextBlock Text="Tu IA. En tu equipo." Style="{StaticResource Heading}"/><TextBlock Text="La edición completa incluye motores y modelos. Las rutas se configuran automáticamente; aquí puedes cambiarlas si lo necesitas." Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="01  /  TRANSCRIPCIÓN · WHISPER.CPP" Style="{StaticResource Caption}"/><TextBlock Text="Ejecutable whisper-cli.exe" Style="{StaticResource Caption}"/><DockPanel><Button DockPanel.Dock="Right" Content="Buscar…" Click="BrowseWhisperClick"/><TextBox x:Name="WhisperPath"/></DockPanel><TextBlock Text="Modelo multilingüe de Whisper · archivo .bin" Style="{StaticResource Caption}"/><DockPanel><Button DockPanel.Dock="Right" Content="Buscar…" Click="BrowseModelClick"/><TextBox x:Name="ModelPath"/></DockPanel><TextBlock Text="Idioma de transcripción" Style="{StaticResource Caption}"/><ComboBox x:Name="LanguageChoice" SelectedIndex="0" Width="220" HorizontalAlignment="Left"><ComboBoxItem Content="Español" Tag="es"/><ComboBoxItem Content="English" Tag="en"/></ComboBox><Button Content="Abrir descargas de Whisper.cpp" Click="WhisperDownloadsClick" HorizontalAlignment="Left"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="02  /  INFORMES · OLLAMA LOCAL" Style="{StaticResource Caption}"/><TextBlock Text="Dirección local" Style="{StaticResource Caption}"/><TextBox x:Name="OllamaUrl" Text="http://127.0.0.1:11434"/><TextBlock Text="Nombre del modelo instalado" Style="{StaticResource Caption}"/><TextBox x:Name="OllamaModel" Text="qwen3:4b"/><TextBlock Text="La edición completa incluye qwen3:1.7b para CPU y Whisper base multilingüe. Ollama se inicia automáticamente en el puerto local 11435. Puedes usar otro motor local si lo configuras aquí." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,18"/><WrapPanel><Button Content="Usar motores incluidos" Click="UseBundledClick"/><Button Content="Guardar ajustes" Click="SaveSettingsClick" Background="#D95531"/><Button x:Name="CheckEngines" Content="Comprobar configuración y Ollama" Click="CheckEnginesClick"/><Button Content="Abrir Ollama" Click="OllamaDownloadsClick"/></WrapPanel><TextBlock x:Name="EngineStatus" Text="Pendiente de configuración" Foreground="#32615B"/></StackPanel></Border>
